<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:converters="clr-namespace:DariuszLabaj.MaterialTheme.Wpf.Converters"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ========================================================= -->
    <!-- RadioButton -->
    <!-- ========================================================= -->

    <ControlTemplate x:Key="md.sys.RadioButton.ControlTemplate" TargetType="RadioButton">
        <Grid x:Name="RootGrid" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{TemplateBinding Height}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Height="{TemplateBinding Height}" Width="{TemplateBinding Height}">
                <Border x:Name="StateLayer" Background="{DynamicResource 80Brush}" CornerRadius="{Binding Path=ActualHeight, RelativeSource={RelativeSource Self}, Converter={converters:ScaleConverter 0.5}}" Opacity="0"/>
                <Border x:Name="OuterCircle" Margin="2" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{Binding Path=ActualHeight, RelativeSource={RelativeSource Self}, Converter={converters:ScaleConverter 0.5}}" Opacity="1">
                    <Border x:Name="InnerDot" Margin="2" Background="{TemplateBinding BorderBrush}" CornerRadius="{Binding Path=ActualHeight, RelativeSource={RelativeSource Self}, Converter={converters:ScaleConverter 0.5}}" Opacity="0"/>
                </Border>
            </Grid>
            <TextBlock Text="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontStyle="{TemplateBinding FontStyle}" FontStretch="{TemplateBinding FontStretch}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <!-- Hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
            </Trigger>
            <!-- Pressed -->
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
            </Trigger>
            <!-- Checked -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="InnerDot" Property="Opacity" Value="1"/>
            </Trigger>
            <!-- Disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.38"/>
                <Setter TargetName="StateLayer" Property="Opacity" Value="0"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="md.radio-button" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource onBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource primaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0 4 0 0"/>
        <Setter Property="FontFamily" Value="{DynamicResource md.ref.typeface.plain}"/>
        <Setter Property="FontSize" Value="{DynamicResource md.sys.typescale.body-medium-size}"/>
        <Setter Property="Height" Value="{DynamicResource md.sys.typescale.body-medium-line-height}"/>
        <Setter Property="Template" Value="{StaticResource md.sys.RadioButton.ControlTemplate}"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

</ResourceDictionary>