    <Style x:Key="md.toggle-button.filled" TargetType="ToggleButton">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="0 4 0 0"/>
        <Setter Property="Background" Value="{DynamicResource primaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource onBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource backgroundBrush}"/>
        <Setter Property="Tag" Value="{DynamicResource onBackgroundBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource md.ref.typeface.plain}"/>
        <Setter Property="FontSize" Value="{DynamicResource md.sys.typescale.label-medium-size}"/>
        <Setter Property="FontWeight" Value="{DynamicResource md.sys.typescale.label-medium-weight}"/>
        <Setter Property="Template" Value="{StaticResource md.sys.ToggleButton.ControlTemplate-filled}"/>
    </Style>
