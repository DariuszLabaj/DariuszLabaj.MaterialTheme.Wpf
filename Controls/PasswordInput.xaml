<UserControl x:Class="DariuszLabaj.MaterialTheme.Wpf.Controls.PasswordInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:DariuszLabaj.MaterialTheme.Wpf.Converters"
             xmlns:local="clr-namespace:DariuszLabaj.MaterialTheme.Wpf.Controls"
             d:Background="White"
             d:Foreground="Red"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:DesaturateColorConverter x:Key="DesaturateColorConverter"/>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="border" CornerRadius="4 4 0 0" BorderThickness="0 0 0 3" BorderBrush="{DynamicResource outlineBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocused, ElementName=TextBoxField}" Value="True">
                            <Setter Property="BorderBrush" Value="{Binding AccentColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=TextBoxField, Path=(Validation.HasError)}" Value="True">
                            <Setter Property="BorderBrush" Value="Red"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox Margin="-2 8 0 0" Grid.Column="0"
                             d:Password="Test"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             FontStretch="{Binding FontStretch, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             FontStyle="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center"
                             Padding="8 4"
                             x:Name="TextBoxField">
                </PasswordBox>
                <Canvas Grid.Column="0">
                    <TextBlock IsHitTestVisible="False" x:Name="label"
                               Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="8 4"
                               Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource DesaturateColorConverter}}"
                               Canvas.Top="12">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
                <Button Grid.Column="1" x:Name="button"
                        Click="Button_Click"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Padding="0" Focusable="False" IsTabStop="False">
                    <Button.Content>
                        <Viewbox MaxHeight="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={converters:ScaleConverter 1.5}}" MinHeight="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={converters:ScaleConverter 1.5}}">
                            <Path Margin="-5 -5 0 0" Data="{StaticResource md.icon.close}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Viewbox>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Template" Value="{DynamicResource md.sys.Button.ControlTemplate-text}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Password, ElementName=TextBoxField}" Value="">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Password, ElementName=TextBoxField}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{Binding SupportingTextBackground,RelativeSource={RelativeSource AncestorType=UserControl}}">
            <TextBlock Text="{Binding SupportingText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontWeight="Regular" FontSize="12"  Margin="16 2" 
                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontStretch="{Binding FontStretch, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontStyle="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{Binding SupportingTextForeground, RelativeSource={RelativeSource AncestorType=UserControl}}">
            </TextBlock>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SupportingText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SupportingText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
