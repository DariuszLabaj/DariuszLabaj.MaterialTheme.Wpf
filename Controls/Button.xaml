                    <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Opacity="1" VerticalAlignment="Center" HorizontalAlignment="Right" RecognizesAccessKey="True">
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </StackPanel>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ContentPresenter" Property="HorizontalAlignment" Value="Center"/>
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
