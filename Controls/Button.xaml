    <Style x:Key="md.button.elevated" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource onPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource primaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource md.sys.typescale.label-medium-size}"/>
        <Setter Property="MinHeight" Value="{DynamicResource md.sys.typescale.label-large-line-height}"/>
        <Setter Property="Template" Value="{StaticResource md.sys.Button.ControlTemplate-elevated}"/>
    </Style>
    <Style x:Key="md.button.filled" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource onPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource primaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource md.sys.typescale.label-medium-size}"/>
        <Setter Property="MinHeight" Value="{DynamicResource md.sys.typescale.label-large-line-height}"/>
        <Setter Property="Template" Value="{StaticResource md.sys.Button.ControlTemplate-filled}"/>
    </Style>
    <Style x:Key="md.button.outlined" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource primaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource md.sys.typescale.label-medium-size}"/>
        <Setter Property="MinHeight" Value="{DynamicResource md.sys.typescale.label-large-line-height}"/>
        <Setter Property="Template" Value="{StaticResource md.sys.Button.ControlTemplate-outlined}"/>
