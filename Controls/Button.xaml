    <Style x:Key="md.button.text" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource primaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource md.sys.typescale.label-medium-size}"/>
        <Setter Property="MinHeight" Value="{DynamicResource md.sys.typescale.label-large-line-height}"/>
        <Setter Property="Template" Value="{StaticResource md.sys.Button.ControlTemplate-text}"/>
