<UserControl x:Class="DariuszLabaj.MaterialTheme.Wpf.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DariuszLabaj.MaterialTheme.Wpf.Controls"
             x:Name="Root"
             MinWidth="220"
             mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#6750A4"/>
        <SolidColorBrush x:Key="OutlineBrush" Color="#79747E"/>
        <Style x:Key="SwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="BorderBrush" Value="#79747E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button x:Name="OpenButton" Click="OpenButton_Click" Padding="12 9" Background="White" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SelectedSwatch" Width="24" Height="24" CornerRadius="6" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" Background="#6750A4"/>
                <StackPanel Grid.Column="1" Margin="10 0 0 0">
                    <TextBlock Text="{Binding Label, ElementName=Root}" FontSize="11"/>
                    <TextBlock x:Name="SelectedHexText" Text="#6750A4" FontSize="14"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="⌄" FontSize="18" Margin="8 0 0 0"/>
            </Grid>
        </Button>
        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=OpenButton}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Closed="PickerPopup_Closed" StaysOpen="False">
            <Border Background="#FFFEFF" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0 6 8 8" Width="310">
                <StackPanel>
                    <DockPanel Margin="0 0 0 14">
                        <TextBlock Text="Wybierz kolor" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border x:Name="PreviewSwatch" Width="30" Height="30" CornerRadius="8" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" Background="#6450A4" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <TextBlock Text="Kolory podstawowe" FontWeight="SemiBold" Margin="0 0 0 6"/>
                    <UniformGrid x:Name="PaletteGrid" Columns="8" Margin="-3 0 -3 10"/>
                    <TextBlock Text="Nasycenie i jasność" FontWeight="SemiBold" Margin="0 0 0 6"/>
                    <Grid Height="142" ClipToBounds="True">
                        <Canvas x:Name="SvCanvas" Background="#6750A4" MouseLeftButtonDown="SvCanvas_MouseLeftButtonDown" MouseMove="SvCanvas_MouseMove" MouseLeftButtonUp="SvCanvas_MouseLeftButtonUp">
                            <Rectangle IsHitTestVisible="False" Width="280" Height="142">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle IsHitTestVisible="False" Width="280" Height="142">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0, 1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="Black" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Ellipse x:Name="SvMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" IsHitTestVisible="False"/>
                        </Canvas>
                    </Grid>
                    <TextBlock Text="Odcień" FontWeight="SemiBold" Margin="0 12 0 4"/>
                    <Slider x:Name="HueSlide" Minimum="0" Maximum="359" Value="267" ValueChanged="HueSlide_ValueChanged"/>
                    <TextBlock Text="HEX" FontWeight="SemiBold" Margin="0 10 0 4"/>
                    <TextBox x:Name="HexTextBox" Text="#6750A4" MaxLength="7" Padding="10 8" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" TextChanged="HexTextBox_TextChanged"/>
                    <TextBlock x:Name="HexErrorText" Text="Wpisz kolor w formacie #RRGGBB." Foreground="#B3261E" FontSize="11" Margin="0 4 0 0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 18 0 0">
                        <Button Content="Anuluj" Click="CancelButton_Click" Padding="16 8" Margin="0 0 8 0" Background="Transparent" BorderThickness="0"/>
                        <Button Content="Wybierz" Click="ConfirmButton_Click" Padding="18 8" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
